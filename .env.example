# ---------------------------------------------------------------------------
# Motor — preencha e renomeie para .env (nunca versionado)
# ---------------------------------------------------------------------------

# Modelos
GOOGLE_API_KEY=            # embeddings (e o card, se LLM_PROVIDER=gemini)
DEEPSEEK_API_KEY=          # interpretação do card
EMBEDDING_MODEL=gemini-embedding-001
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60

# Cota e ritmo dos embeddings
QUOTA_DAILY_TEXTS=1000     # limite diário do plano; usado na verificação antes de ingerir
EMBEDDING_BATCH_CHARS=16000
# Pausa mínima entre lotes; a pausa real sai do tamanho do lote, para respeitar
# o limite por minuto abaixo.
EMBEDDING_BATCH_DELAY=10
# Medido no plano gratuito: o limite por minuto conta TEXTOS, não requisições
# (~100 por minuto). Um lote de 20 trechos a cada 10 s leva 429.
EMBEDDING_TEXTS_PER_MINUTE=100

# Banco (Supabase)
# DATABASE_URL — conexão do POOLER, modo transação (porta 6543). É a que a
# função serverless usa. Não acrescente ?pgbouncer=true: esse parâmetro é do
# ecossistema Node e o cliente Python o recusa como parâmetro inválido.
DATABASE_URL=postgresql://postgres.<ref-do-projeto>:<senha>@<host>.pooler.supabase.com:6543/postgres

# DIRECT_URL — conexão de sessão (porta 5432), usada para aplicar migrações.
DIRECT_URL=postgresql://postgres.<ref-do-projeto>:<senha>@<host>.pooler.supabase.com:5432/postgres

# Storage e autenticação (Supabase)
# Nomes atuais do painel: a chave pública é "publishable" e a de servidor é
# "secret" (os antigos nomes anon e service_role seguem aparecendo na
# documentação antiga). A chave secret ignora as políticas de acesso e por
# isso nunca é usada em consulta do usuário.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Endereço das chaves públicas de assinatura, usado para conferir o token do
# usuário antes de assumir a identidade dele na conexão ao banco.
SUPABASE_JWKS_URL=

# ---------------------------------------------------------------------------
# Cliente (web/) — variáveis do Vite, com prefixo VITE_
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
