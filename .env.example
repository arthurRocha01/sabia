# ---------------------------------------------------------------------------
# Motor — preencha e renomeie para .env (nunca versionado)
# ---------------------------------------------------------------------------

# Modelos
GOOGLE_API_KEY=            # embeddings (e o card, se LLM_PROVIDER=gemini)
DEEPSEEK_API_KEY=          # interpretação do card
EMBEDDING_MODEL=gemini-embedding-001
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60

# Cota e ritmo dos embeddings
QUOTA_DAILY_TEXTS=1000     # limite diário do plano; usado na verificação antes de ingerir
EMBEDDING_BATCH_CHARS=16000
EMBEDDING_BATCH_DELAY=10

# Banco (Supabase)
# DATABASE_URL — conexão do POOLER, modo transação (porta 6543). É a que a
# função serverless usa. Não acrescente ?pgbouncer=true: esse parâmetro é do
# ecossistema Node e o cliente Python o recusa como parâmetro inválido.
DATABASE_URL=postgresql://postgres.<ref-do-projeto>:<senha>@<host>.pooler.supabase.com:6543/postgres

# DIRECT_URL — conexão de sessão (porta 5432), usada para aplicar migrações.
DIRECT_URL=postgresql://postgres.<ref-do-projeto>:<senha>@<host>.pooler.supabase.com:5432/postgres

# Storage e autenticação (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # apenas no servidor; ignora as políticas de acesso

# ---------------------------------------------------------------------------
# Cliente (web/) — variáveis do Vite, com prefixo VITE_
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
