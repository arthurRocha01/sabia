# ---------------------------------------------------------------------------
# Motor — preencha e renomeie para .env (nunca versionado)
# ---------------------------------------------------------------------------

# Modelos
GOOGLE_API_KEY=            # embeddings (e o card, se LLM_PROVIDER=gemini)
DEEPSEEK_API_KEY=          # interpretação do card
EMBEDDING_MODEL=gemini-embedding-001
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60

# Cota e ritmo dos embeddings
QUOTA_DAILY_TEXTS=1000     # limite diário do plano; usado na verificação antes de ingerir
EMBEDDING_BATCH_CHARS=16000
EMBEDDING_BATCH_DELAY=10

# Banco (Supabase) — use a conexão do pooler, modo transação
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres

# Storage e autenticação (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # apenas no servidor; ignora as políticas de acesso

# ---------------------------------------------------------------------------
# Cliente (web/) — variáveis do Vite, com prefixo VITE_
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
